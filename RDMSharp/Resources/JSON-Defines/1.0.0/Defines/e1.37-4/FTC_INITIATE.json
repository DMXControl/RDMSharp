{
  "name": "FTC_INITIATE",
  "displayName": "FTC Initiate Transfer",
  "notes": "E1.37-4-2026 File Transfer Control, Section 13.1. The response lists 15 fields (38 octets) while the standard states a PDL of 0x22; the field list is used here.",
  "manufacturer_id": 0,
  "pid": 4608,
  "version": 1,
  "get_request_subdevice_range": [
    "root"
  ],
  "get_request": [
    {
      "name": "session_id",
      "type": "uint8",
      "notes": "Controllers shall set this to NO_SESSIONID_OFFERED.",
      "ranges": [
        {
          "minimum": 0,
          "maximum": 0
        }
      ],
      "labels": [
        {
          "name": "NO_SESSIONID_OFFERED",
          "value": 0
        }
      ]
    },
    {
      "name": "file_id",
      "type": "uint8",
      "ranges": [
        {
          "minimum": 0,
          "maximum": 254
        }
      ],
      "labels": [
        {
          "name": "NO_FILEID_OFFERED",
          "value": 0
        }
      ]
    },
    {
      "name": "ftc_version_major",
      "type": "uint8",
      "notes": "FTCVersion major, 1 for this standard."
    },
    {
      "name": "ftc_version_minor",
      "type": "uint8",
      "notes": "FTCVersion minor, 0 for this standard."
    },
    {
      "name": "transfer_flags",
      "type": "bitField",
      "notes": "Table A-5. The upper bits are reserved or manufacturer specific.",
      "size": 16,
      "bits": [
        {
          "name": "test_mode",
          "index": 0
        },
        {
          "name": "download",
          "index": 1
        }
      ]
    }
  ],
  "get_response": [
